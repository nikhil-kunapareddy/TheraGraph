# TheraGraph configuration.
#
# Copy to .env and adjust. Every value has a working default for local development;
# nothing here is required to run the stack. With ENVIRONMENT=production the application
# refuses to boot unless AUTH_ENABLED=true and JWT_SECRET is a non-default secret of at
# least 32 characters (generate one with `openssl rand -hex 32`).
#
# Never commit a filled-in .env: it is gitignored, keep it that way.

# ------------------------------------------------------------------ application
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console                # console for humans, json in deployments
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------- datastores
# Postgres in deployments; the docker-compose stack publishes it on host port 55432.
DATABASE_URL=postgresql+asyncpg://theragraph:theragraph@localhost:55432/theragraph
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:63790/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_S=3600

# --------------------------------------------------------------- object storage
# `filesystem` keeps model artifacts and reports on local disk (no MinIO needed).
STORAGE_BACKEND=filesystem        # filesystem | s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=theragraph
S3_ACCESS_KEY_ID=theragraph
S3_SECRET_ACCESS_KEY=theragraph-secret
S3_REGION=us-east-1

# ------------------------------------------------------------------- the agent
# With no key the agent runs its deterministic planner: the full workflow, tool calls,
# validation and report all work, without an LLM and without network access.
ANTHROPIC_API_KEY=
AGENT_LLM_BACKEND=anthropic       # anthropic | deterministic
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium               # low | medium | high | xhigh | max
AGENT_MAX_TOKENS=16000
AGENT_MAX_STEPS=12

# ------------------------------------------------------------------- ingestion
# Set false on a public deployment: user requests then serve the pre-ingested corpus
# and never call Open Targets or ChEMBL.
ALLOW_LIVE_INGESTION=true
HTTP_TIMEOUT_S=30
HTTP_MAX_RETRIES=4
HTTP_USER_AGENT=TheraGraph/0.1 (research workbench; +https://github.com/nikhil-kunapareddy/TheraGraph)

# ------------------------------------------------------------ jobs and workers
JOB_QUEUE_BACKEND=redis           # redis | inline (inline runs jobs in-process)
JOB_MAX_ATTEMPTS=3
JOB_VISIBILITY_TIMEOUT_S=900
JOB_WORKER_CONCURRENCY=4

# --------------------------------------------------------------------- security
AUTH_ENABLED=false
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_S=86400
API_KEYS=                         # comma-separated
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AGENT_REQUESTS=20      # tighter: these requests spend model tokens
RATE_LIMIT_WINDOW_S=60
MAX_REQUEST_BYTES=2000000

# ---------------------------------------------------------------- observability
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=theragraph-api
SLOW_QUERY_THRESHOLD_MS=250

# -------------------------------------------------------------------- frontend
VITE_API_BASE=/api/v1
VITE_API_PROXY=http://localhost:8000
